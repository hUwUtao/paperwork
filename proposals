#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
skill_script="$script_dir/cli/paper-proposals.js"
[[ -f "$skill_script" ]] || { printf 'error: paper-proposals CLI is missing\n' >&2; exit 1; }

command=${1:-serve}
case "$command" in
  web|gui) command=serve; shift ;;
  *) [[ $# -eq 0 ]] || shift ;;
esac

export PAPER_PROPOSALS_ROOT="${PAPER_PROPOSALS_ROOT:-$PWD/.agents/paperwork/proposals}"
exec bun "$skill_script" "$command" "$@"
